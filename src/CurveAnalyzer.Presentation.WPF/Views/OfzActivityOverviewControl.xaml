<UserControl
    x:Class="CurveAnalyzer.Presentation.WPF.Views.OfzActivityOverviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:CurveAnalyzer.Presentation.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:CurveAnalyzer.Presentation.WPF.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:OfzActivityViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:ActivityHeatmapColorConverter x:Key="ActivityHeatmapColorConverter" />
        <converters:OfzSpecialSummaryMetricValueConverter x:Key="OfzSpecialSummaryMetricValueConverter" />
        <converters:OfzBreadthContributorValueConverter x:Key="OfzBreadthContributorValueConverter" />
        <converters:OfzIndexContextValueConverter x:Key="OfzIndexContextValueConverter" />
        <converters:OfzCashflowValueConverter x:Key="OfzCashflowValueConverter" />
        <converters:OfzSeasonalityValueConverter x:Key="OfzSeasonalityValueConverter" />
        <Style x:Key="HeatmapCellButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,1,1,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{Binding Path=., Converter={StaticResource ActivityHeatmapColorConverter}}" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="CellBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="#333333" />
                                <Setter TargetName="CellBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="#000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox
            Grid.Row="0"
            Margin="0,0,0,6"
            Header="Выводы"
            Visibility="{Binding HasMarketSummary, Converter={StaticResource BoolToVis}}">
            <Grid MaxHeight="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox
                    Grid.Row="0"
                    Grid.Column="0"
                    BorderThickness="0"
                    ItemsSource="{Binding SummaryFindings}"
                    SelectedItem="{Binding SelectedSummaryFinding, Mode=TwoWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,2,6,3">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Text="{Binding Text}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="4,4,4,0"
                    Foreground="DimGray"
                    Text="{Binding SelectedSummaryEvidenceText}"
                    TextWrapping="Wrap" />

                <DockPanel
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    Margin="0,2,0,0"
                    LastChildFill="True">
                    <DockPanel
                        Margin="0,0,0,4"
                        DockPanel.Dock="Top"
                        LastChildFill="False">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            FontWeight="SemiBold"
                            Text="Сводка" />
                        <Button
                            Margin="8,0,0,0"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            Command="{Binding CopySummaryJsonCommand}"
                            Content="Копия"
                            DockPanel.Dock="Right" />
                        <Button
                            Margin="4,0,0,0"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            Command="{Binding SaveSummaryJsonCommand}"
                            Content="Файл"
                            DockPanel.Dock="Right" />
                    </DockPanel>

                    <TabControl>
                        <TabItem Header="Ширина">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Ширина рынка" />
                                <TextBlock
                                    Margin="0,1,0,3"
                                    FontSize="10"
                                    Foreground="DimGray"
                                    Text="по периоду выводов: направления доходности, активность и концентрация оборота"
                                    TextWrapping="Wrap" />
                                <DataGrid
                                    MaxHeight="158"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding MarketSummary.BreadthDays}"
                                    SelectedItem="{Binding SelectedBreadthDay, Mode=TwoWay}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="64"
                                            Binding="{Binding TradeDate, Mode=OneWay, StringFormat={}{0:dd.MM}}"
                                            Header="Дата" />
                                        <DataGridTextColumn
                                            Width="42"
                                            Binding="{Binding Direction.YieldUpCount, Mode=OneWay}"
                                            Header="Рост" />
                                        <DataGridTextColumn
                                            Width="50"
                                            Binding="{Binding Direction.YieldDownCount, Mode=OneWay}"
                                            Header="Сниж." />
                                        <DataGridTextColumn
                                            Width="58"
                                            Binding="{Binding Direction.UnchangedCount, Mode=OneWay}"
                                            Header="Без изм." />
                                        <DataGridTextColumn
                                            Width="46"
                                            Binding="{Binding NotComparableIssueCount, Mode=OneWay}"
                                            Header="n/a" />
                                        <DataGridTextColumn
                                            Width="54"
                                            Binding="{Binding ActiveIssueCount, Mode=OneWay}"
                                            Header="Акт." />
                                        <DataGridTextColumn
                                            Width="58"
                                            Binding="{Binding Concentration.Top5Share, Mode=OneWay, StringFormat={}{0:P0}, TargetNullValue=n/a}"
                                            Header="Top-5" />
                                        <DataGridTextColumn
                                            Width="58"
                                            Binding="{Binding Concentration.Top10Share, Mode=OneWay, StringFormat={}{0:P0}, TargetNullValue=n/a}"
                                            Header="Top-10" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Индекс">
                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="132" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="96" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    FontWeight="SemiBold"
                                    Text="Индексный фон" />
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,1,0,3"
                                    FontSize="10"
                                    Foreground="DimGray"
                                    Text="{Binding IndexContextStatusMessage}"
                                    TextWrapping="Wrap" />
                                <DataGrid
                                    Grid.Row="2"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding IndexContextDays}"
                                    SelectedItem="{Binding SelectedIndexContextDay, Mode=TwoWay}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="64"
                                            Binding="{Binding TradeDate, Mode=OneWay, StringFormat={}{0:dd.MM}}"
                                            Header="Дата" />
                                        <DataGridTextColumn
                                            Width="78"
                                            Binding="{Binding PriceIndexPoint.Close, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=Value}"
                                            Header="RGBI" />
                                        <DataGridTextColumn
                                            Width="70"
                                            Binding="{Binding PriceIndexPoint.DailyChangePercent, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=ChangePercent}"
                                            Header="RGBI Δ" />
                                        <DataGridTextColumn
                                            Width="78"
                                            Binding="{Binding TotalReturnIndexPoint.Close, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=Value}"
                                            Header="RGBITR" />
                                        <DataGridTextColumn
                                            Width="70"
                                            Binding="{Binding TotalReturnIndexPoint.DailyChangePercent, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=ChangePercent}"
                                            Header="TR Δ" />
                                        <DataGridTextColumn
                                            Width="72"
                                            Binding="{Binding MarketDirection, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=Direction}"
                                            Header="Фон" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock
                                    Grid.Row="3"
                                    Margin="0,3,0,2"
                                    FontSize="10"
                                    Foreground="DimGray"
                                    Text="{Binding SelectedIndexContextDaySummary}"
                                    TextWrapping="Wrap" />
                                <DataGrid
                                    Grid.Row="4"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding SelectedIndexContextPoints}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Visibility="{Binding HasSelectedIndexContextPoints, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="82"
                                            Binding="{Binding SecId, Mode=OneWay}"
                                            Header="SECID" />
                                        <DataGridTextColumn
                                            Width="58"
                                            Binding="{Binding DurationBucket, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=Bucket}"
                                            Header="Bucket" />
                                        <DataGridTextColumn
                                            Width="76"
                                            Binding="{Binding ReturnKind, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=ReturnKind}"
                                            Header="Тип" />
                                        <DataGridTextColumn
                                            Width="70"
                                            Binding="{Binding Close, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=Value}"
                                            Header="Close" />
                                        <DataGridTextColumn
                                            Width="70"
                                            Binding="{Binding DailyChangePercent, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=ChangePercent}"
                                            Header="Δ" />
                                        <DataGridTextColumn
                                            Width="66"
                                            Binding="{Binding Yield, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=Yield}"
                                            Header="Yield" />
                                        <DataGridTextColumn
                                            Width="66"
                                            Binding="{Binding Duration, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=Duration}"
                                            Header="Dur." />
                                        <DataGridTextColumn
                                            Width="68"
                                            Binding="{Binding SourceKind, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=Source}"
                                            Header="Source" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ItemsControl
                                    Grid.Row="5"
                                    Margin="0,3,0,0"
                                    ItemsSource="{Binding SelectedIndexLimitations}"
                                    Visibility="{Binding HasSelectedIndexLimitations, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="DimGray"
                                                Text="{Binding Text}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </TabItem>

                        <TabItem Header="События">
                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="104" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="92" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="54" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,3"
                                    FontSize="10"
                                    Foreground="DimGray"
                                    Text="{Binding CashflowStatusMessage}"
                                    TextWrapping="Wrap" />
                                <DataGrid
                                    Grid.Row="1"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding CashflowEvents}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="74" Binding="{Binding EventDate, Mode=OneWay, StringFormat={}{0:dd.MM.yy}}" Header="Дата" />
                                        <DataGridTextColumn Width="88" Binding="{Binding ShortName, Mode=OneWay, TargetNullValue=n/a}" Header="Выпуск" />
                                        <DataGridTextColumn Width="70" Binding="{Binding EventType, Mode=OneWay, Converter={StaticResource OfzCashflowValueConverter}, ConverterParameter=EventType}" Header="Тип" />
                                        <DataGridTextColumn Width="66" Binding="{Binding Value, Mode=OneWay, Converter={StaticResource OfzCashflowValueConverter}, ConverterParameter=Value}" Header="Value" />
                                        <DataGridTextColumn Width="66" Binding="{Binding ValuePercent, Mode=OneWay, Converter={StaticResource OfzCashflowValueConverter}, ConverterParameter=Percent}" Header="%" />
                                        <DataGridTextColumn Width="70" Binding="{Binding SourceKind, Mode=OneWay, Converter={StaticResource OfzCashflowValueConverter}, ConverterParameter=Source}" Header="Source" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,4,0,2"
                                    FontWeight="SemiBold"
                                    Text="Ближайшие" />
                                <DataGrid
                                    Grid.Row="3"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding UpcomingCashflowEvents}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="74" Binding="{Binding EventDate, Mode=OneWay, StringFormat={}{0:dd.MM.yy}}" Header="Дата" />
                                        <DataGridTextColumn Width="88" Binding="{Binding ShortName, Mode=OneWay, TargetNullValue=n/a}" Header="Выпуск" />
                                        <DataGridTextColumn Width="70" Binding="{Binding EventType, Mode=OneWay, Converter={StaticResource OfzCashflowValueConverter}, ConverterParameter=EventType}" Header="Тип" />
                                        <DataGridTextColumn Width="66" Binding="{Binding Value, Mode=OneWay, Converter={StaticResource OfzCashflowValueConverter}, ConverterParameter=Value}" Header="Value" />
                                        <DataGridTextColumn Width="66" Binding="{Binding ValuePercent, Mode=OneWay, Converter={StaticResource OfzCashflowValueConverter}, ConverterParameter=Percent}" Header="%" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock
                                    Grid.Row="4"
                                    Margin="0,4,0,2"
                                    FontWeight="SemiBold"
                                    Text="Связь с активностью" />
                                <DataGrid
                                    Grid.Row="5"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding CashflowActivityLinks}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Visibility="{Binding HasCashflowActivityLinks, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="74" Binding="{Binding TradeDate, Mode=OneWay, StringFormat={}{0:dd.MM.yy}}" Header="Trade" />
                                        <DataGridTextColumn Width="88" Binding="{Binding ShortName, Mode=OneWay}" Header="Выпуск" />
                                        <DataGridTextColumn Width="74" Binding="{Binding Event.EventDate, Mode=OneWay, StringFormat={}{0:dd.MM.yy}}" Header="Event" />
                                        <DataGridTextColumn Width="70" Binding="{Binding Event.EventType, Mode=OneWay, Converter={StaticResource OfzCashflowValueConverter}, ConverterParameter=EventType}" Header="Тип" />
                                        <DataGridTextColumn Width="46" Binding="{Binding DaysToEvent, Mode=OneWay, Converter={StaticResource OfzCashflowValueConverter}, ConverterParameter=Days}" Header="Δдн" />
                                        <DataGridTextColumn Width="78" Binding="{Binding Value, Mode=OneWay, StringFormat={}{0:N0}, TargetNullValue=n/a}" Header="Оборот" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Сезонность">
                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="96" />
                                    <RowDefinition Height="96" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="78" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,3"
                                    FontSize="10"
                                    Foreground="DimGray"
                                    Text="{Binding SeasonalityStatusMessage}"
                                    TextWrapping="Wrap" />
                                <DataGrid
                                    Grid.Row="1"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding WeekdaySeasonalityBuckets}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Visibility="{Binding HasWeekdaySeasonalityBuckets, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="76" Binding="{Binding Label, Mode=OneWay}" Header="День" />
                                        <DataGridTextColumn Width="54" Binding="{Binding ObservationCount, Mode=OneWay}" Header="Набл." />
                                        <DataGridTextColumn Width="48" Binding="{Binding ActiveDayCount, Mode=OneWay}" Header="Акт." />
                                        <DataGridTextColumn Width="74" Binding="{Binding MedianTotalValue, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=MoneyMillion}" Header="Med mln" />
                                        <DataGridTextColumn Width="74" Binding="{Binding AverageTotalValue, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=MoneyMillion}" Header="Avg mln" />
                                        <DataGridTextColumn Width="62" Binding="{Binding MedianNumTrades, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=Number}" Header="Сделок" />
                                        <DataGridTextColumn Width="62" Binding="{Binding MedianActiveIssueCount, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=Decimal}" Header="Вып." />
                                        <DataGridTextColumn Width="58" Binding="{Binding UpDayShare, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=Percent}" Header="Рост" />
                                        <DataGridTextColumn Width="78" Binding="{Binding BaselineQuality, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=BaselineQuality}" Header="База" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid
                                    Grid.Row="2"
                                    Margin="0,4,0,0"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding MonthSeasonalityBuckets}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Visibility="{Binding HasMonthSeasonalityBuckets, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="76" Binding="{Binding Label, Mode=OneWay}" Header="Месяц" />
                                        <DataGridTextColumn Width="54" Binding="{Binding ObservationCount, Mode=OneWay}" Header="Набл." />
                                        <DataGridTextColumn Width="48" Binding="{Binding ActiveDayCount, Mode=OneWay}" Header="Акт." />
                                        <DataGridTextColumn Width="74" Binding="{Binding MedianTotalValue, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=MoneyMillion}" Header="Med mln" />
                                        <DataGridTextColumn Width="74" Binding="{Binding AverageTotalValue, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=MoneyMillion}" Header="Avg mln" />
                                        <DataGridTextColumn Width="62" Binding="{Binding MedianNumTrades, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=Number}" Header="Сделок" />
                                        <DataGridTextColumn Width="62" Binding="{Binding MedianActiveIssueCount, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=Decimal}" Header="Вып." />
                                        <DataGridTextColumn Width="58" Binding="{Binding DownDayShare, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=Percent}" Header="Сниж." />
                                        <DataGridTextColumn Width="78" Binding="{Binding BaselineQuality, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=BaselineQuality}" Header="База" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock
                                    Grid.Row="3"
                                    Margin="0,4,0,2"
                                    FontWeight="SemiBold"
                                    Text="Выводы" />
                                <DataGrid
                                    Grid.Row="4"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding SeasonalityFindings}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Visibility="{Binding HasSeasonalityFindings, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="74" Binding="{Binding TradeDate, Mode=OneWay, StringFormat={}{0:dd.MM.yy}}" Header="Дата" />
                                        <DataGridTextColumn Width="70" Binding="{Binding BucketKind, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=BucketKind}" Header="Тип" />
                                        <DataGridTextColumn Width="76" Binding="{Binding BucketLabel, Mode=OneWay}" Header="Bucket" />
                                        <DataGridTextColumn Width="86" Binding="{Binding Kind, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=FindingKind}" Header="Сигнал" />
                                        <DataGridTextColumn Width="74" Binding="{Binding ActualValue, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=MoneyMillion}" Header="Факт mln" />
                                        <DataGridTextColumn Width="74" Binding="{Binding BaselineMedianValue, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=MoneyMillion}" Header="База mln" />
                                        <DataGridTextColumn Width="58" Binding="{Binding ValueRatio, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=Ratio}" Header="Ratio" />
                                        <DataGridTextColumn Width="58" Binding="{Binding ActualNumTrades, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=Number}" Header="Сделки" />
                                        <DataGridTextColumn Width="58" Binding="{Binding BaselineMedianNumTrades, Mode=OneWay, Converter={StaticResource OfzSeasonalityValueConverter}, ConverterParameter=Number}" Header="База" />
                                        <DataGridTextColumn Width="50" Binding="{Binding BaselineObservationCount, Mode=OneWay}" Header="N" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ItemsControl
                                    Grid.Row="5"
                                    Margin="0,3,0,0"
                                    ItemsSource="{Binding SeasonalityLimitations}"
                                    Visibility="{Binding HasSeasonalityLimitations, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="DimGray"
                                                Text="{Binding Text}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Сегменты">
                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="112" />
                                    <RowDefinition Height="*" MinHeight="80" />
                                </Grid.RowDefinitions>
                                <DataGrid
                                    Grid.Row="0"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding IndexSegments}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Visibility="{Binding HasIndexSegments, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="62"
                                            Binding="{Binding Bucket, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=Bucket}"
                                            Header="Bucket" />
                                        <DataGridTextColumn
                                            Width="82"
                                            Binding="{Binding PriceSeriesSecId, Mode=OneWay, TargetNullValue=n/a}"
                                            Header="Price" />
                                        <DataGridTextColumn
                                            Width="82"
                                            Binding="{Binding TotalReturnSeriesSecId, Mode=OneWay, TargetNullValue=n/a}"
                                            Header="TR" />
                                        <DataGridTextColumn
                                            Width="70"
                                            Binding="{Binding PeriodChangePercent, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=ChangePercent}"
                                            Header="Период" />
                                        <DataGridTextColumn
                                            Width="62"
                                            Binding="{Binding LatestYield, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=Yield}"
                                            Header="Yield" />
                                        <DataGridTextColumn
                                            Width="62"
                                            Binding="{Binding LatestDuration, Mode=OneWay, Converter={StaticResource OfzIndexContextValueConverter}, ConverterParameter=Duration}"
                                            Header="Dur." />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ScrollViewer
                                    Grid.Row="1"
                                    Margin="0,4,0,0"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SegmentSummaries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,4"
                                                    Padding="0,0,0,4"
                                                    BorderBrush="#E0E0E0"
                                                    BorderThickness="0,0,0,1">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold">
                                                            <Run Text="{Binding CouponTypeMarker}" />
                                                            <Run Text=": " />
                                                            <Run Text="{Binding TotalValue, StringFormat={}{0:N0}}" />
                                                            <Run Text=" " />
                                                            <Run Text="{Binding TotalValueUnitMarker, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="DimGray"
                                                            TextWrapping="Wrap">
                                                            <Run Text="активных " />
                                                            <Run Text="{Binding ActiveIssueCount}" />
                                                            <Run Text=", weak " />
                                                            <Run Text="{Binding WeakLiquidityCount}" />
                                                            <Run Text=", missing quotes " />
                                                            <Run Text="{Binding MissingQuotesCount}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Спец">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Специальные метрики" />
                                <TextBlock
                                    Margin="0,1,0,3"
                                    FontSize="10"
                                    Foreground="DimGray"
                                    Text="для ОФЗ-ПК и ОФЗ-ИН: ожидаемые ставки/инфляция из ISS, без подстановки нулей"
                                    TextWrapping="Wrap" />
                                <DataGrid
                                    MaxHeight="158"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding MarketSummary.SpecialMetrics}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="150"
                                            Binding="{Binding Label, Mode=OneWay}"
                                            Header="Метрика" />
                                        <DataGridTextColumn
                                            Width="78"
                                            Binding="{Binding ., Mode=OneWay, Converter={StaticResource OfzSpecialSummaryMetricValueConverter}, ConverterParameter=Value}"
                                            Header="Значение" />
                                        <DataGridTextColumn
                                            Width="78"
                                            Binding="{Binding ., Mode=OneWay, Converter={StaticResource OfzSpecialSummaryMetricValueConverter}, ConverterParameter=ObservedAt}"
                                            Header="Дата" />
                                        <DataGridTextColumn
                                            Width="88"
                                            Binding="{Binding ., Mode=OneWay, Converter={StaticResource OfzSpecialSummaryMetricValueConverter}, ConverterParameter=Availability}"
                                            Header="Статус" />
                                        <DataGridTextColumn
                                            Width="72"
                                            Binding="{Binding ., Mode=OneWay, Converter={StaticResource OfzSpecialSummaryMetricValueConverter}, ConverterParameter=Source}"
                                            Header="Источник" />
                                        <DataGridTextColumn
                                            Width="52"
                                            Binding="{Binding HistoricalPointCount, Mode=OneWay}"
                                            Header="Точек" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Ограничения">
                            <ScrollViewer
                                Margin="0,4,0,0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SummaryLimitations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,1,0,0"
                                                FontSize="10"
                                                Foreground="DimGray"
                                                Text="{Binding Text}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="День">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Выбранный день" />
                                <TextBlock
                                    Margin="0,1,0,3"
                                    FontSize="10"
                                    Foreground="DimGray"
                                    Text="{Binding SelectedBreadthDaySummary}"
                                    TextWrapping="Wrap" />
                                <DataGrid
                                    MaxHeight="136"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding SelectedBreadthContributors}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Visibility="{Binding HasSelectedBreadthContributors, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="90"
                                            Binding="{Binding ShortName, Mode=OneWay}"
                                            Header="Выпуск" />
                                        <DataGridTextColumn
                                            Width="58"
                                            Binding="{Binding CouponTypeMarker, Mode=OneWay, TargetNullValue=n/a}"
                                            Header="Тип" />
                                        <DataGridTextColumn
                                            Width="76"
                                            Binding="{Binding YieldDirection, Mode=OneWay, Converter={StaticResource OfzBreadthContributorValueConverter}}"
                                            Header="Доходн." />
                                        <DataGridTextColumn
                                            Width="64"
                                            Binding="{Binding YieldMove, Mode=OneWay, StringFormat={}{0:N2}, TargetNullValue=n/a}"
                                            Header="Δ" />
                                        <DataGridTextColumn
                                            Width="85"
                                            Binding="{Binding Value, Mode=OneWay, StringFormat={}{0:N0}, TargetNullValue=n/a}"
                                            Header="Оборот" />
                                        <DataGridTextColumn
                                            Width="55"
                                            Binding="{Binding ValueShare, Mode=OneWay, StringFormat={}{0:P0}, TargetNullValue=n/a}"
                                            Header="Доля" />
                                        <DataGridTextColumn
                                            Width="118"
                                            Binding="{Binding Reason, Mode=OneWay, Converter={StaticResource OfzBreadthContributorValueConverter}}"
                                            Header="Роль" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ItemsControl
                                    Margin="0,3,0,0"
                                    ItemsSource="{Binding SelectedBreadthLimitations}"
                                    Visibility="{Binding HasSelectedBreadthLimitations, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="DimGray"
                                                Text="{Binding Text}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Карта активности">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock
                                Width="150"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Выпуск" />
                            <ItemsControl ItemsSource="{Binding HeatmapDates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Width="32"
                                            Height="28"
                                            Margin="0,1,1,1"
                                            FontSize="10"
                                            Text="{Binding StringFormat={}{0:dd.MM}}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding HeatmapRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Height="22">
                                        <TextBlock
                                            Width="150"
                                            VerticalAlignment="Center"
                                            Text="{Binding ShortName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding SecId}" />
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Command="{Binding DataContext.SelectHeatmapCellCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource HeatmapCellButtonStyle}">
                                                        <Button.ToolTip>
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding ShortName}" />
                                                                <TextBlock Text="{Binding SecId}" />
                                                                <TextBlock Text="{Binding CouponTypeMarker, StringFormat=Тип {0}, TargetNullValue=Тип n/a}" />
                                                                <TextBlock Text="{Binding TradeDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                                                <TextBlock Text="{Binding ActivityScore, StringFormat=Score {0:N2}, TargetNullValue=Score n/a}" />
                                                                <TextBlock Text="{Binding Value, StringFormat=Оборот {0:N0}, TargetNullValue=Оборот n/a}" />
                                                                <TextBlock Text="{Binding YieldMove, StringFormat=Yield Δ {0:N2}, TargetNullValue=Yield Δ n/a}" />
                                                                <TextBlock Text="{Binding Status}" />
                                                            </StackPanel>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    Text="{Binding SelectedHeatmapSummary}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
