<UserControl
    x:Class="CurveAnalyzer.Presentation.WPF.Views.OfzActivityOverviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:CurveAnalyzer.Presentation.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:CurveAnalyzer.Presentation.WPF.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:OfzActivityViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:ActivityHeatmapColorConverter x:Key="ActivityHeatmapColorConverter" />
        <Style x:Key="HeatmapCellButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,1,1,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{Binding Converter={StaticResource ActivityHeatmapColorConverter}}" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="CellBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="#333333" />
                                <Setter TargetName="CellBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="#000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox
            Grid.Row="0"
            Margin="0,0,0,6"
            Header="Выводы"
            Visibility="{Binding HasMarketSummary, Converter={StaticResource BoolToVis}}">
            <Grid MaxHeight="210">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox
                    Grid.Row="0"
                    Grid.Column="0"
                    BorderThickness="0"
                    ItemsSource="{Binding SummaryFindings}"
                    SelectedItem="{Binding SelectedSummaryFinding, Mode=TwoWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,2,6,3">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Text="{Binding Text}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="4,4,4,0"
                    Foreground="DimGray"
                    Text="{Binding SelectedSummaryEvidenceText}"
                    TextWrapping="Wrap" />

                <DockPanel
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    Margin="0,2,0,0"
                    LastChildFill="True">
                    <DockPanel Margin="0,0,0,4" DockPanel.Dock="Top">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            FontWeight="SemiBold"
                            Text="Сегменты" />
                        <Button
                            Margin="8,0,0,0"
                            Padding="8,2"
                            Command="{Binding CopySummaryJsonCommand}"
                            Content="JSON"
                            DockPanel.Dock="Right" />
                    </DockPanel>

                    <Border
                        DockPanel.Dock="Bottom"
                        Margin="0,4,0,0"
                        Padding="0,4,0,0"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding HasSummaryLimitations, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Ограничения" />
                            <ScrollViewer
                                MaxHeight="52"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SummaryLimitations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,1,0,0"
                                                FontSize="10"
                                                Foreground="DimGray"
                                                Text="{Binding Text}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SegmentSummaries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,4"
                                        Padding="0,0,0,4"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding CouponTypeMarker}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding TotalValue, StringFormat={}{0:N0}}" />
                                                <Run Text=" " />
                                                <Run Text="{Binding TotalValueUnitMarker, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="DimGray"
                                                TextWrapping="Wrap">
                                                <Run Text="активных " />
                                                <Run Text="{Binding ActiveIssueCount}" />
                                                <Run Text=", weak " />
                                                <Run Text="{Binding WeakLiquidityCount}" />
                                                <Run Text=", missing quotes " />
                                                <Run Text="{Binding MissingQuotesCount}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Карта активности">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock
                                Width="150"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Выпуск" />
                            <ItemsControl ItemsSource="{Binding HeatmapDates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Width="32"
                                            Height="28"
                                            Margin="0,1,1,1"
                                            FontSize="10"
                                            Text="{Binding StringFormat={}{0:dd.MM}}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding HeatmapRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Height="22">
                                        <TextBlock
                                            Width="150"
                                            VerticalAlignment="Center"
                                            Text="{Binding ShortName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding SecId}" />
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Command="{Binding DataContext.SelectHeatmapCellCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource HeatmapCellButtonStyle}">
                                                        <Button.ToolTip>
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding ShortName}" />
                                                                <TextBlock Text="{Binding SecId}" />
                                                                <TextBlock Text="{Binding CouponTypeMarker, StringFormat=Тип {0}, TargetNullValue=Тип n/a}" />
                                                                <TextBlock Text="{Binding TradeDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                                                <TextBlock Text="{Binding ActivityScore, StringFormat=Score {0:N2}, TargetNullValue=Score n/a}" />
                                                                <TextBlock Text="{Binding Value, StringFormat=Оборот {0:N0}, TargetNullValue=Оборот n/a}" />
                                                                <TextBlock Text="{Binding YieldMove, StringFormat=Yield Δ {0:N2}, TargetNullValue=Yield Δ n/a}" />
                                                                <TextBlock Text="{Binding Status}" />
                                                            </StackPanel>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    Text="{Binding SelectedHeatmapSummary}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
