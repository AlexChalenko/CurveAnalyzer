<UserControl
    x:Class="CurveAnalyzer.Presentation.WPF.Views.RateChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:CurveAnalyzer.Presentation.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skia="clr-namespace:LiveChartsCore.SkiaSharpView;assembly=LiveChartsCore.SkiaSharpView"
    xmlns:viewmodels="clr-namespace:CurveAnalyzer.Presentation.WPF.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:RateChartViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:RateValuesToSeriesConverter x:Key="RateValuesToSeriesConverter" />
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Header="Настройки">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Период: " />
                <ComboBox
                    Width="50"
                    Margin="0,0,5,0"
                    ItemsSource="{Binding Periods}"
                    SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}" />
                <!--<Button Command="{Binding PlotChartCommand}" Content="Построить график" />-->
            </StackPanel>
        </GroupBox>
        <lvc:CartesianChart
            Grid.Row="1"
            AnimationsSpeed="0:0:0"
            Background="White"
            LegendPosition="Top"
            Series="{Binding ZcycArray, Converter={StaticResource RateValuesToSeriesConverter}}"
            ZoomMode="X">
            <lvc:CartesianChart.XAxes>
                <!--<lvc:Axis Title="Дюрация" LabelFormatter="{Binding Formatter}" Labels="{Binding Labels}" />-->
                <lvc:AxesCollection>
                    <skia:Axis Name="Дюрация" />
                </lvc:AxesCollection>
            </lvc:CartesianChart.XAxes>
            <lvc:CartesianChart.YAxes>
                <lvc:AxesCollection>
                    <skia:Axis Name="Доходность" />
                </lvc:AxesCollection>
            </lvc:CartesianChart.YAxes>
        </lvc:CartesianChart>
    </Grid>
</UserControl>
