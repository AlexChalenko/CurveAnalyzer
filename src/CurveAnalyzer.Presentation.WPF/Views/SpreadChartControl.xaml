<UserControl
    x:Class="CurveAnalyzer.Presentation.WPF.Views.SpreadChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:CurveAnalyzer.Presentation.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skia="clr-namespace:LiveChartsCore.SkiaSharpView;assembly=LiveChartsCore.SkiaSharpView"
    xmlns:viewmodels="clr-namespace:CurveAnalyzer.Presentation.WPF.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:SpreadChartViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:SpreadValuesToSeriesConverter x:Key="SpreadValuesToSeriesConverter" />
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GroupBox
            Grid.Row="0"
            Margin="5,0,5,0"
            Header="Настройки">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="Padding" Value="5" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    Text="Первый период:" />
                <ComboBox
                    Width="50"
                    Height="25"
                    ItemsSource="{Binding PeriodsList}"
                    SelectedItem="{Binding PeriodFirst}"
                    SelectedValue="{Binding Periods.Period1, ValidatesOnDataErrors=True, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <!--  SelectedItem="{Binding PeriodFirst}" />  -->
                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    Text="Второй период:" />
                <ComboBox
                    Width="50"
                    Height="25"
                    ItemsSource="{Binding PeriodsList}"
                    SelectedItem="{Binding PeriodSecond}"
                    SelectedValue="{Binding Periods.Period2, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Mode=TwoWay}" />
                <!--
                    />
                -->
                <!--<Button Command="{Binding PlotChartCommand}" Content="Получить спред" />-->
            </StackPanel>
        </GroupBox>
        <lvc:CartesianChart
            Grid.Row="1"
            AnimationsSpeed="0:0:0"
            Background="White"
            LegendPosition="Top"
            Series="{Binding Values, Converter={StaticResource SpreadValuesToSeriesConverter}}"
            ZoomMode="X">
            <lvc:CartesianChart.XAxes>
                <!--<lvc:Axis Title="Дюрация" LabelFormatter="{Binding Formatter}" Labels="{Binding Labels}" />-->
                <lvc:AxesCollection>
                    <skia:Axis Name="Дюрация" />
                </lvc:AxesCollection>
            </lvc:CartesianChart.XAxes>
            <lvc:CartesianChart.YAxes>
                <lvc:AxesCollection>
                    <skia:Axis Name="Доходность" />
                </lvc:AxesCollection>
            </lvc:CartesianChart.YAxes>
        </lvc:CartesianChart>
    </Grid>
</UserControl>
