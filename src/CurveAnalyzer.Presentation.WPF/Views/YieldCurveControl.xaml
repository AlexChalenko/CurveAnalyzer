<UserControl
    x:Class="CurveAnalyzer.Presentation.WPF.Views.YieldCurveControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:CurveAnalyzer.Presentation.WPF.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:lvcs="clr-namespace:LiveChartsCore.SkiaSharpView;assembly=LiveChartsCore.SkiaSharpView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:CurveAnalyzer.Presentation.WPF.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:YieldCurveViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Header="Настройки">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="Padding" Value="5" />
                    </Style>
                </StackPanel.Resources>
                <!--<Button
                x:Name="GetDataButton"
                d:Content="Получить график"
                Command="{Binding PlotChartCommand}"
                Content="{Binding ButtonName}"
                FontFamily="/Fonts/#Roboto" />-->
                <DatePicker
                    behaviors:DatePickerBlackoutDatesBehavior.Dates="{Binding BlackoutDates}"
                    VerticalAlignment="Center"
                    DisplayDateEnd="{Binding EndDate}"
                    DisplayDateStart="{Binding StartDate}"
                    FontFamily="/Fonts/#Roboto"
                    IsEnabled="{Binding IsReady}"
                    SelectedDate="{Binding SelectedDate}" />
                <Button
                    Command="{Binding ClearChartCommand}"
                    Content="Очистить"
                    FontFamily="/Fonts/#Roboto" />
                <CheckBox
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Bottom"
                    Content="Обновление"
                    FontFamily="/Fonts/#Roboto" />
                <Button
                    Command="{Binding PlotPreviosDayCommand}"
                    Content="Играть"
                    FontFamily="/Fonts/#Roboto" />
            </StackPanel>
        </GroupBox>
        <lvc:CartesianChart
            x:Name="YieldChart"
            behaviors:YieldCurveSeriesBehavior.ItemsSource="{Binding ZcycDatas}"
            Grid.Row="1"
            AnimationsSpeed="0:0:0"
            Background="White"
            LegendPosition="Top">
            <lvc:CartesianChart.XAxes>
                <!--<lvc:Axis Title="Дюрация" LabelFormatter="{Binding Formatter}" Labels="{Binding Labels}" />-->
                <lvc:AxesCollection>
                    <lvcs:Axis Name="Дюрация" />
                </lvc:AxesCollection>
            </lvc:CartesianChart.XAxes>
            <lvc:CartesianChart.YAxes>
                <lvc:AxesCollection>
                    <lvcs:Axis Name="Доходность" />
                </lvc:AxesCollection>
            </lvc:CartesianChart.YAxes>
        </lvc:CartesianChart>
    </Grid>
</UserControl>
